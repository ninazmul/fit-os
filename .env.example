# ============================================================
# FitOS — Environment Variable TEMPLATE
# ============================================================
# ⚠️  Do NOT put real secrets here — this file is for reference
#    and is safe to commit to git. Copy it to `.env.local` and
#    fill in the real values, or paste them into Vercel Env Vars
#    directly (recommended).
# ============================================================

# ------------------------------------------------------------
# Clerk Authentication  (REQUIRED)
# ------------------------------------------------------------
# Get real values from https://dashboard.clerk.com → API Keys
# Use `pk_test_*` / `sk_test_*` for staging, swap for
# `pk_live_*` / `sk_live_*` when you go live.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ------------------------------------------------------------
# Clerk Auth Paths  (REQUIRED)
# ------------------------------------------------------------

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ------------------------------------------------------------
# Clerk — Custom Domain / Vercel Prod  (RECOMMENDED)
# ------------------------------------------------------------
# Uncomment ONCE you own a custom domain + add it in Clerk:
#
# NEXT_PUBLIC_CLERK_DOMAIN=
# NEXT_PUBLIC_CLERK_IS_SATELLITE=false
# NEXT_PUBLIC_CLERK_PROXY_URL=

# ------------------------------------------------------------
# Clerk — Middleware Encryption Key  (RECOMMENDED)
# ------------------------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️  Use the SAME value across Prod + Preview + Dev.

CLERK_ENCRYPTION_KEY=

# ------------------------------------------------------------
# MongoDB  (REQUIRED)
# ------------------------------------------------------------

MONGODB_URI=

# ------------------------------------------------------------
# Google AdSense  (OPTIONAL)
# ------------------------------------------------------------
# Both vars can be left blank to disable all ads in dev & prod.
#
# NEXT_PUBLIC_ADSENSE_CLIENT_ID - required for BOTH Auto Ads +
#   manual <AdUnit /> placements. Format: ca-pub-XXXXXXXXXXXXXXXXX
#   Get it from https://adsense.google.com -> Sites -> "Add site"
#
# NEXT_PUBLIC_ADSENSE_SLOT_ID - default ad unit slot ID used by
#   every <AdUnit /> that doesn't pass an explicit slotId prop.
#   Create one per site: AdSense -> Ads -> Ad units -> New ad unit.
#   Format: 10-12 digit numeric ID (no prefix) e.g. 1234567890
#
# Ads are automatically disabled in `NODE_ENV === development`.
# Both vars start with NEXT_PUBLIC_ so they ship to the browser
#    (required for AdSense's client-side JS library - this is
#    intended behavior; AdSense publisher IDs are public).

NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_ID=
